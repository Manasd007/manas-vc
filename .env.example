# Copy this file to .env.local and fill in the keys. .env.local is git-ignored.
# On Vercel, add the same names under Settings > Environment Variables.

# OpenAI: transcription, answers and the voice. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Groq: backup transcription (Whisper) and backup answers. https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides. Leave blank to use the defaults.
OPENAI_MODEL=
OPENAI_TTS_MODEL=
OPENAI_VOICE=
OPENAI_STT_MODEL=
GROQ_MODEL=
GROQ_FALLBACK_MODEL=
GROQ_STT_MODEL=
